# Cloudflare Pages security headers. Vite copies public/ to dist/ root;
# Pages serves dist/_headers for every response (static assets + Functions).
#
# Why this matters here: /api/linear auto-attaches the user's read/write
# Linear token to any same-origin request, and HttpOnly does NOT stop an
# in-page script from calling it. CSP + frame-ancestors are the
# defense-in-depth layer behind React escaping and safeHref.
#
# script-src 'self'        — Vite emits external hashed modules, no inline JS.
# style-src  'unsafe-inline' — required: Tailwind + many React style={{…}} attrs.
# img-src    data:         — Vite inlines small assets (e.g. the logo) as data URIs.
# connect-src 'self'       — the SPA only ever fetches /api/linear.
# frame-ancestors 'none'   — the drag-to-edit UI must not be clickjackable.
# report-to csp            — violations POST to /csp-report (functions/csp-report.ts).
# X-Robots-Tag noindex     — this is a private tool; keep it out of search.
# HSTS                     — Cloudflare serves https; pin it for 1 year.
# Cache-Control no-store    — the SPA shell + API must always be live; Cloudflare
#                             was serving a stale page. Hashed /assets/* are
#                             overridden below (filenames change per build, so
#                             they cache forever without ever going stale).
/*
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'none'; object-src 'none'; form-action 'self'; report-uri /csp-report; report-to csp
  Reporting-Endpoints: csp="/csp-report"
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()
  X-Robots-Tag: noindex, nofollow
  Cache-Control: no-store, must-revalidate

# Content-hashed build output: safe to cache immutably (more specific rule wins).
/assets/*
  Cache-Control: public, max-age=31536000, immutable
