{
  "name": "ggantt",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "concurrently -k -n vite,cf -c green,blue \"vite --port 7374 --strictPort\" \"wrangler pages dev --proxy 7374 --port 7373\"",
    "dev:vite-only": "vite --port 7374",
    "typecheck": "tsc -b --noEmit",
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "format": "biome format --write",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "deploy": "npm run build && wrangler pages deploy dist --project-name ggantt --commit-dirty=true",
    "redeploy": "npm run deploy"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.2.8",
    "@tanstack/react-query": "^5.97.0",
    "date-fns": "^4.1.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.11",
    "@cloudflare/workers-types": "^4.20251101.0",
    "@tailwindcss/vite": "^4.2.2",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^9.1.0",
    "tailwindcss": "^4.2.2",
    "typescript": "~6.0.2",
    "ultracite": "^7.4.4",
    "vite": "^8.0.4",
    "wrangler": "^4.50.0"
  }
}
