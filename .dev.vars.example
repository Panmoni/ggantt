# Local dev secrets for `wrangler pages dev`. Copy to `.dev.vars` and fill in.
# Production values go in the Cloudflare Pages dashboard (Settings → Environment variables).

LINEAR_CLIENT_ID=
LINEAR_CLIENT_SECRET=
OAUTH_REDIRECT_URI=http://localhost:7373/oauth/callback
# Comma-separated Linear account emails allowed to sign in. REQUIRED — if blank,
# sign-in is disabled for everyone (fail closed). Use your Linear login email.
ALLOWED_EMAILS=
# Secret used to encrypt the token cookie (AES-256-GCM). REQUIRED — if unset,
# /oauth/callback and /api/linear return 500. Generate one with:
#   openssl rand -base64 32
# Rotating it just forces everyone to log in again.
COOKIE_SECRET=
